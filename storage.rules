rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── BRANDING ──────────────────────────────────────────────
    // Admin logo upload — any authenticated user (anonymous auth
    // is the app-level gate; PIN/password is the app guard).
    match /branding/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size <= 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // ── EMPLOYEE AVATARS ──────────────────────────────────────
    // AI-generated caricature profile pictures per employee.
    // Upload path: avatars/{storeId}/{empId}.jpg
    match /avatars/{storeId}/{fileName} {
      allow read:   if request.auth != null;
      allow write:  if request.auth != null
                    && request.resource.size <= 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // ── ENTRY PHOTOS ──────────────────────────────────────────
    // Photos attached to daily recap entries.
    // Upload path: entries/{store}/{entryId}_{index}.{ext}
    match /entries/{storeId}/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size <= 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

  }
}
