rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── STORES ──────────────────────────────────────────────
    match /stores/{storeId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['pin','managerName'])
                    && request.resource.data.pin is string
                    && request.resource.data.pin.size() >= 4;
      allow update: if request.auth != null
                    && request.resource.data.keys().hasAll(['pin','managerName'])
                    && request.resource.data.pin is string
                    && request.resource.data.pin.size() >= 4;
      allow delete: if false;
    }

    // ── ENTRIES ─────────────────────────────────────────────
    match /entries/{entryId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['store','author','text','type','status','time'])
                    && request.resource.data.status == 'open'
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 2000;
      allow update: if request.auth != null
                    && request.resource.data.store == resource.data.store;
      allow delete: if request.auth != null;
    }

    // ── MESSAGES ────────────────────────────────────────────
    match /messages/{messageId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['store','from','text','time'])
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 5000;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // ── ADMIN ─────────────────────────────────────────────────
    // Covers admin/config, admin/broadcast, admin/appConfig, etc.
    // Master password hash + PIN are the app-level guards.
    match /admin/{adminDoc} {
      allow read, write: if request.auth != null;
    }

    // ── FEEDBACK ─────────────────────────────────────────────
    // Managers submit feedback; admin views/updates/deletes.
    match /feedback/{feedbackId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['store','from','type','text','time','status'])
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 3000
                    && request.resource.data.type in ['bug','idea','other'];
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // ── AUDIT LOG ────────────────────────────────────────────
    // Written by admin hub on key actions; read by admin only.
    match /audit_log/{logId} {
      allow read, write: if request.auth != null;
    }

    // ── COACHING ─────────────────────────────────────────────
    // Manager creates records; employees update to add their signature.
    match /coaching/{docId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['store','manager','name','type','savedAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // ── EMPLOYEES ────────────────────────────────────────────
    // Store managers add/remove employees for name autocomplete.
    match /employees/{empId} {
      allow read, write: if request.auth != null;
    }

    // ── CATCH-ALL ────────────────────────────────────────────
    // Covers reg_codes and any future collections.
    // NOTE: this overrides the specific rules above for any operation not
    // explicitly denied — that is intentional for this app's trust model
    // (anonymous auth = the only gate, PIN/password = app-level guard).
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
